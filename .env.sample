# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in.  cp .env.sample .env
#
# Do NOT name your copy `.env.local` — Next.js loads that automatically and it
# overrides `.env`, so a half-filled one silently breaks local dev.
#
# NOT here on purpose: ticket prices, event dates, venue, track capacity, the
# closed-form message and the form dropdowns. Those all live in the database and
# are edited at /admin without a deploy. If you are looking for ORDER_AMOUNT, it
# was removed — pricing is now settings.priceCapstone / priceSingle / priceBundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# SSL is applied automatically for remote hosts and skipped for localhost /
# 127.0.0.1 (or any URL with ?sslmode=disable), so a plain local container works.
# On Coolify use the Postgres service's INTERNAL hostname, not the public domain
# — the public one is not exposed on 5432 and will refuse the connection.
DATABASE_URL=postgres://postgres:pfe@localhost:55432/pfe

# ── Site ────────────────────────────────────────────────────────────────────
# The externally reachable origin. No trailing slash. Used to build the ticket
# QR target, the Cashfree notify_url and the post-payment return_url.
#
# SITE_URL, not NEXT_PUBLIC_SITE_URL, and the missing prefix is the whole point.
# Next inlines every NEXT_PUBLIC_* read at BUILD time — including reads inside
# server-only route handlers — so the old variable froze the build machine's
# value into the bundle and setting it at runtime in Coolify changed nothing.
# See src/lib/siteUrl.ts. On Coolify this must be a plain runtime variable.
#
# Required. There is no fallback: a missing value used to produce
# `undefined/verify?orderId=…`, which yields a valid-looking QR on a dead URL.
SITE_URL=http://localhost:3000

# Deprecated. Read only as a fallback, and that fallback is NOT a safety net in
# Docker: `.dockerignore` excludes `.env`, so the image builds with this unset
# and it compiles to `process.env.SITE_URL || ""`. In any container deployment
# SITE_URL is REQUIRED — without it every checkout 500s. Set it before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_MERCHANT_NAME='ACM MPSTME'

# ── Admin access ────────────────────────────────────────────────────────────
# HTTP Basic. The usernames are fixed in code: `admin` and `acm`. Only the
# passwords are configurable. An unset or empty value fails closed — nobody gets
# in rather than everybody.
ADMIN_PASSWORD=changeme
MEMBER_PASSWORD=changeme

# ── Cashfree ────────────────────────────────────────────────────────────────
# CASHFREE_ENV drives BOTH the server SDK and the browser checkout widget.
# Anything other than the literal string PRODUCTION means sandbox.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX   # or PRODUCTION

# ── Email (ticket delivery) ─────────────────────────────────────────────────
# SMTP_SECURE=true for port 465 (implicit TLS); false for 587 (STARTTLS).
# Leave blank locally: a send failure is caught and logged, the registration
# still completes, and `emailSentAt` stays null so /admin can find it.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM='PFE <pfe@example.com>'

# ── Google Sheets sync ──────────────────────────────────────────────────────
# From a service account JSON key (Cloud Console -> Credentials). Two gotchas:
#   1. SHARE the spreadsheet with GOOGLE_SHEETS_CLIENT_EMAIL as Editor. Enabling
#      the API is not enough — without the share you get a 403.
#   2. Keep the private key's literal \n escapes exactly as they appear in the
#      JSON. Do not expand them into real line breaks.
# The `PFE2026` tab is created automatically and is the only tab this app writes.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=""
GOOGLE_SHEETS_SHEET_ID=

# How often the app syncs itself to the sheet, in minutes. 0 disables the
# scheduler entirely; unset means 10.
#
# The scheduler does NOT run under `pnpm dev` unless SYNC_IN_DEV=true. Your local
# GOOGLE_SHEETS_SHEET_ID is almost certainly the real spreadsheet — it is the only
# one the service account can reach — so a scheduler running locally would push
# your test registrations into the live sheet. Only set SYNC_IN_DEV against a
# spreadsheet you are willing to have overwritten.
#
# The sync used to be fired by a cron configured outside this repository. It
# stopped in August 2026 and went unnoticed for two days, because nobody could
# find where it lived and a rejected trigger logged nothing at all. The timer
# lives in src/instrumentation.ts now, so it deploys with the app.
SYNC_INTERVAL_MINUTES=10

# Optional. Lets an EXTERNAL trigger POST /api/sync-sheet with
# `Authorization: Bearer <secret>` instead of the admin password.
#
# Worth setting if anything outside the app still calls the sync: sharing
# ADMIN_PASSWORD means rotating that password silently kills the sync, which is
# the leading explanation for the outage above. Leave blank to accept admin
# Basic auth only.
CRON_SECRET=
