<mjml>
  <mj-head>
    <mj-title>PFE Workshop Registration Confirmed</mj-title>
    <mj-preview>Your registration for Programming For Everyone workshop is confirmed!</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Segoe UI', Tahoma, Geneva, Verdana, sans-serif" />
      <mj-text font-size="16px" color="#333333" line-height="1.6" />
      <mj-button background-color="#e97bfc" color="#000000" border-radius="8px" font-weight="bold" />
    </mj-attributes>
    <mj-style inline="inline">
      .gradient-bg {
        background: linear-gradient(135deg, #1a0d1f 0%, #0d0d1a 50%, #1a0d1f 100%);
      }

      .purple-text {
        color: #e97bfc !important;
        font-weight: bold;
      }

      .qr-container {
        background: #ffffff;
        border: 2px dashed #e97bfc;
        border-radius: 12px;
        padding: 15px;
        display: inline-block;
      }

      .details-table td {
        padding: 12px 0;
        vertical-align: top;
      }

      .details-label {
        font-weight: bold;
        color: #1a0d1f;
        width: 120px;
      }

      .details-value {
        color: #333333;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#0d0d1a">
    <!-- Header Section -->
    <mj-section css-class="gradient-bg" padding="40px 20px">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="32px" font-weight="bold" padding-bottom="10px">
          PFE - Programming For Everyone
        </mj-text>
        <mj-text align="center" color="#f8c8fc" font-size="18px">
          by ACM MPSTME
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Confirmation Message -->
    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column>
        <mj-text font-size="24px" font-weight="bold" color="#1a0d1f" align="center" padding-bottom="20px">
          Registration Confirmed! 🎉
        </mj-text>
        <mj-text font-size="18px" color="#333333" align="center" padding-bottom="30px">
          Hi ${name},<br />
          Welcome to the <span class="purple-text">${domain}</span> track!
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Event Details -->
    <mj-section background-color="#f8f9fa" padding="30px 20px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#1a0d1f" align="center" padding-bottom="20px">
          Workshop Details
        </mj-text>
        <mj-table css-class="details-table" width="100%">
          <tr>
            <td class="details-label">Event:</td>
            <td class="details-value">Programming For Everyone Workshop</td>
          </tr>
          <tr>
            <td class="details-label">Domain:</td>
            <td class="purple-text">${domain}</td>
          </tr>
          <tr>
            <td class="details-label">Order ID:</td>
            <td class="purple-text">${orderId}</td>
          </tr>
          <tr>
            <td class="details-label">Dates:</td>
            <td class="details-value">16 - 18 September</td>
          </tr>
          <tr>
            <td class="details-label">Time:</td>
            <td class="details-value">5:00 PM - 7:00 PM (All 3 days)</td>
          </tr>
          <tr>
            <td class="details-label">Venue:</td>
            <td class="details-value">MPSTME Campus, Mumbai. <br />(Classroom details will be shared soon)</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- QR Code Section -->
    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#1a0d1f" align="center" padding-bottom="20px">
          Your Ticket
        </mj-text>
        <mj-text font-size="14px" color="#666666" align="center" padding-bottom="20px">
          Please present this QR code at the venue for entry
        </mj-text>
        <mj-text align="center" padding="0">
          <div style="
            background: #ffffff;
            border: 2px dashed #e97bfc;
            border-radius: 12px;
            padding: 15px;
            display: inline-block;
          ">
            <img src="cid:qr-code" alt="Entry QR Code" width="200px" style="display: block;" />
          </div>
        </mj-text>
        <mj-text font-size="12px" color="#999999" align="center" padding-top="10px">
          Save this email or take a screenshot for easy access
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Important Information -->
    <mj-section background-color="#f8f9fa" padding="30px 20px">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold" color="#1a0d1f" align="center" padding-bottom="15px">
          Important Information
        </mj-text>
        <mj-text font-size="14px" color="#333333">• Bring your laptop/device for hands-on sessions</mj-text>
        <mj-text font-size="14px" color="#333333">• Certificate of participation will be awarded only if at least 2 lectures are attended</mj-text>
        <mj-text font-size="14px" color="#333333">• Workshop materials will be shared digitally</mj-text>
      </mj-column>
    </mj-section>

    <!-- Contact Information -->
    <mj-section background-color="#ffffff" padding="30px 20px">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold" color="#1a0d1f" align="center" padding-bottom="15px">
          Need Help?
        </mj-text>
        <mj-text font-size="14px" color="#333333" align="center" padding-bottom="20px">
          Contact us at <a href="mailto:pfe@mpst.me" style="color: #e97bfc; text-decoration: none;">pfe@mpst.me</a> or,
        </mj-text>
        <mj-button href="https://wa.me/919076195651" font-size="14px" padding="10px 20px">
          WhatsApp Support
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section css-class="gradient-bg" padding="30px 20px">
      <mj-column>
        <mj-text align="center" color="#f8c8fc" font-size="16px" font-weight="bold" padding-bottom="10px">
          <a href="https://mpst.me" style="color: #e97bfc; text-decoration: none;">ACM MPSTME</a>
        </mj-text>
        <mj-text align="center" color="#cccccc" font-size="12px" padding-bottom="10px">
          Mukesh Patel School of Technology Management &amp; Engineering
        </mj-text>
        <mj-text align="center" color="#999999" font-size="10px">
          This email was sent because you registered and paid for the PFE Workshop 2025.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>